# Copy to .env for local work. On Railway, set the same names in the service's Variables tab.
APP_ENV=local                      # local | staging | production
APP_PASSWORD=change-me             # the one team password (spec.md §1)
APP_SECRET=                        # 32+ random chars; signs the session cookie. `openssl rand -hex 32`
DATABASE_URL=sqlite:///./local.db  # Railway's Postgres plugin fills this in automatically
ANTHROPIC_API_KEY=                 # from platform.claude.com/settings/keys — never in Git
MODEL=claude-opus-5-5
MODEL_EFFORT=medium                # low | medium | high
HISTORY_LIMIT=20                   # messages resent per turn (Lesson 1: the context window costs money)
RATE_LIMIT_PER_HOUR=30             # per user
DAILY_CAP_USD=3.00                 # hard stop for the whole app, per local day
TIMEZONE=Asia/Jerusalem
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR (JSON logs on stdout)
CRON_SECRET=                       # for POST /internal/digest; the cron service sends it as X-Cron-Secret
DIGEST_WEBHOOK_URL=                # optional: Slack/Telegram-style webhook that receives {"text": ...}
# TEST_DATABASE_URL=               # tests only: run the suite on PostgreSQL, e.g. postgresql+psycopg://user:pass@localhost:5432/test (the schema is dropped and rebuilt)
# MODEL_PROVIDER=fake              # tests only: no network, scripted replies
